# 2. Are our highly engaged browsers actually converting into buyers, or is there major friction on the site?
query = """
CREATE OR REPLACE TABLE engagement_conversion_summary AS
SELECT 
  CASE 
    WHEN page_clicks < 5 THEN 'Low Engagement (<5 clicks)'
    WHEN page_clicks BETWEEN 5 AND 14 THEN 'Medium Engagement (5-20 clicks)'
    ELSE 'High Engagement (25+ clicks)'
  END AS engagement_tier,
  COUNT(DISTINCT session_id) AS total_sessions,
  SUM(CASE WHEN flight_booked = TRUE OR hotel_booked = TRUE THEN 1 ELSE 0 END) AS total_bookings,
  ROUND(SUM(CASE WHEN flight_booked = TRUE OR hotel_booked = TRUE THEN 1 ELSE 0 END) * 100.0 / COUNT(DISTINCT session_id), 2) AS conversion_rate
FROM workspace.default.sessions_filtered
GROUP BY 1
ORDER BY 1
"""


# 3. What percentage of our booked sessions successfully bundle both a flight and a hotel, and where are we missing out?
query = """
SELECT 
  CASE 
    WHEN flight_booked = TRUE AND hotel_booked = TRUE THEN 'Bundle (Flight + Hotel)'
    WHEN flight_booked = TRUE AND hotel_booked = FALSE THEN 'Flight Only'
    WHEN flight_booked = FALSE AND hotel_booked = TRUE THEN 'Hotel Only'
    ELSE 'No Booking (Browse Only)'
  END AS session_outcome,
  COUNT(DISTINCT session_id) AS session_count,
  ROUND(COUNT(DISTINCT session_id) * 100.0 / SUM(COUNT(DISTINCT session_id)) OVER(), 2) AS percentage_of_traffic
FROM workspace.default.sessions_filtered
GROUP BY 1
ORDER BY session_count DESC
"""


# 4. Are cancellations driven by spontaneous booking behavior, or do they correlate heavily with high-click browsing sessions?
query = """
SELECT 
  CASE 
    WHEN page_clicks < 10 THEN 'Quick Browse (<10 Clicks)'
    ELSE 'Deep Search (10+ Clicks)'
  END AS search_depth,
  COUNT(DISTINCT session_id) AS total_booked_sessions,
  SUM(CASE WHEN cancellation = TRUE THEN 1 ELSE 0 END) AS total_cancelled_trips,
  ROUND(SUM(CASE WHEN cancellation = TRUE THEN 1 ELSE 0 END) * 100.0 / COUNT(DISTINCT session_id), 2) AS cancellation_rate
FROM workspace.default.sessions_filtered
WHERE flight_booked = TRUE OR hotel_booked = TRUE
GROUP BY search_depth
ORDER BY search_depth
"""


# 5. At what hours of the day do users browse out of boredom vs. when do they log on to spend money?
