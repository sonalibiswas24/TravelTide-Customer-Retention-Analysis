# 5: Age Generational Distribution

import pandas as pd
import matplotlib.pyplot as plt

# Load user_agg_features as pandas DataFrame
df = spark.table("user_agg_features").toPandas()

# Calculate age from birthdate
today = pd.Timestamp.today().normalize()
df['birthdate'] = pd.to_datetime(df['birthdate'], errors='coerce')
df['age'] = (today - df['birthdate']).dt.days // 365

# Define generational buckets
def get_generation(age):
    if pd.isnull(age):
        return 'Unknown'
    if age < 27:
        return 'Gen Z'
    elif 27 <= age < 43:
        return 'Millennial'
    elif 43 <= age < 59:
        return 'Gen X'
    elif 59 <= age < 77:
        return 'Baby Boomer'
    else:
        return 'Silent/Older'

df['generation'] = df['age'].apply(get_generation)

# Count users per generation
generation_counts = df['generation'].value_counts().sort_index()
generation_pct = (generation_counts * 100.0 / generation_counts.sum()).round(2)

# Bar chart: Age Generational Distribution
plt.figure(figsize=(10, 6))
bars = plt.bar(generation_counts.index, generation_counts.values, color='#4ecdc4', edgecolor='black', alpha=0.85)
plt.xlabel('Generation', fontsize=14, fontweight='bold')
plt.ylabel('Number of Users', fontsize=14, fontweight='bold')
plt.title('Age Generational Distribution of Users', fontsize=16, fontweight='bold', pad=15)
for i, (count, pct) in enumerate(zip(generation_counts.values, generation_pct.values)):
    plt.text(i, count + 5, f"{count} ({pct}%)", ha='center', va='bottom', fontsize=12, fontweight='bold')
plt.grid(axis='y', alpha=0.3, linewidth=1)
plt.tight_layout()
plt.show()

display(pd.DataFrame({'Generation': generation_counts.index, 'User Count': generation_counts.values, 'Percentage': generation_pct.values}))


# 6: : Gender-Based Regional Distribution
import pandas as pd
import matplotlib.pyplot as plt

# Load user_agg_features as pandas DataFrame
df = spark.table("user_agg_features").toPandas()

# Group by home_country and gender, count users
gender_region = df.groupby(['home_country', 'gender']).size().reset_index(name='user_count')

# Pivot for stacked bar chart
pivot = gender_region.pivot(index='home_country', columns='gender', values='user_count').fillna(0)

# Sort by total users descending
pivot['total'] = pivot.sum(axis=1)
pivot = pivot.sort_values('total', ascending=False).drop(columns='total')

# Plot stacked bar chart
pivot.plot(kind='bar', stacked=True, figsize=(14, 7), color=['#4ecdc4', '#ff6b6b', '#ffd93d', '#95e1d3'])
plt.xlabel('Home Country', fontsize=14, fontweight='bold')
plt.ylabel('Number of Users', fontsize=14, fontweight='bold')
plt.title('Gender-Based Regional Distribution of Users', fontsize=16, fontweight='bold', pad=15)
plt.legend(title='Gender', fontsize=12)
plt.tight_layout()
plt.show()

display(gender_region)


